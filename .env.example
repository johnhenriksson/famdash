# Published ICS link from Outlook.com (Settings > Calendar > Shared calendars > Publish a calendar)
ICS_URL=https://outlook.live.com/owa/calendar/XXXXXXXX/XXXXXXXX/reachcalendar.ics

# IANA timezone for the household
TZ=Europe/Stockholm

# monday | sunday
WEEK_START=monday

# How often the server re-fetches the ICS feed
REFRESH_MINUTES=10

PORT=3000
